{
	"name": "automatic-plugin-manager",
	"version": "1.2.1",
	"main": "main.js",
	"description": "Install, enable, and configure Obsidian community plugins from JSON files for syncing vault setups across devices.",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts src --ext .ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"plugin-manager",
		"automatic-installation",
		"plugin-sync",
		"vault-configuration",
		"community-plugins"
	],
	"author": "Konstantin Volobuev",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "^0.27.7",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"vitest": "^5.0.5"
	}
}
