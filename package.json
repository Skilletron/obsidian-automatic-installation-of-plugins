{
	"name": "automatic-plugin-manager",
	"version": "1.2.3",
	"main": "main.js",
	"description": "Install, enable, and configure Obsidian community plugins from JSON files for syncing vault setups across devices.",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint main.ts src --ext .ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts",
		"test:android": "npm run build && wdio run ./wdio.mobile.conf.mts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"plugin-manager",
		"automatic-installation",
		"plugin-sync",
		"vault-configuration",
		"community-plugins"
	],
	"author": "Konstantin Volobuev",
	"license": "MIT",
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.5",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"@wdio/appium-service": "^9.32.0",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"@wdio/spec-reporter": "^9.32.0",
		"appium": "^3.9.0",
		"appium-uiautomator2-driver": "^8.7.3",
		"esbuild": "^0.27.7",
		"mocha": "^10.8.2",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"tsx": "^4.23.15",
		"typescript": "4.7.4",
		"vitest": "^5.0.5",
		"wdio-obsidian-reporter": "^3.5.0",
		"wdio-obsidian-service": "^3.5.0",
		"webdriverio": "^9.32.0"
	}
}
